# Settings the bot reads from environment variables. None is required.
# Copy this file to .env to keep your own values together (.env is never uploaded).
# Windows: set them with  setx NAME value  or in System > Environment Variables.

# Website auto mode: 1 = runs each market by itself after a session closes, 0 = only when you press Run
TBOT_AUTO=1
# Markets auto mode looks after
TBOT_AUTO_MARKETS=india,us

# Optional Telegram summary after each daily run (leave empty to switch off)
TBOT_TELEGRAM_TOKEN=
TBOT_TELEGRAM_CHAT_ID=

# Optional: other places for the practice account and the emergency stop file
# TBOT_STATE_DIR=state
# TBOT_STOP_FILE=STOP
